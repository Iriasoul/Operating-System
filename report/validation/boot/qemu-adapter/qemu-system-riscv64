#!/bin/bash
# Verification-only QEMU argument adapter.
#
# QEMU 7.0 / OpenSBI does not use "-device loader,file=...,addr=..." to set
# the next-stage entry address. This adapter translates exactly this form:
#
#   -device loader,file=<path>,addr=0x80200000
#     -> -kernel <path>
#
# and rejects every other loader form, a different addr, more than one loader
# argument, or an invocation that already contains -kernel. All remaining
# arguments (serial redirection, monitor, no-reboot, ...) are passed through
# unchanged. The real emulator is selected with QEMU_REAL.

set -u

real=${QEMU_REAL:-/opt/qemu/bin/qemu-system-riscv64}
if [ ! -x "$real" ]; then
    echo "qemu adapter: real emulator is not executable: $real" >&2
    echo "qemu adapter: set QEMU_REAL to the qemu-system-riscv64 binary" >&2
    exit 2
fi

args=()
translated=0
while [ $# -gt 0 ]; do
    if [ "$1" = "-kernel" ]; then
        echo "qemu adapter: refusing an invocation that already uses -kernel" >&2
        exit 2
    fi

    if [ "$1" = "-device" ] && [ $# -ge 2 ] && [[ "$2" == loader,* ]]; then
        spec=$2
        case "$spec" in
        loader,file=*,addr=*)
            rest=${spec#loader,file=}
            file=${rest%%,addr=*}
            addr=${rest##*,addr=}
            if [ -z "$file" ] || [ "$addr" != "0x80200000" ]; then
                echo "qemu adapter: unsupported loader form: $spec" >&2
                echo "qemu adapter: only loader,file=<path>,addr=0x80200000 is supported" >&2
                exit 2
            fi
            if [ "$translated" -ne 0 ]; then
                echo "qemu adapter: more than one loader argument is not supported" >&2
                exit 2
            fi
            args+=(-kernel "$file")
            translated=1
            shift 2
            continue
            ;;
        *)
            echo "qemu adapter: unsupported -device argument: $spec" >&2
            exit 2
            ;;
        esac
    fi

    args+=("$1")
    shift
done

if [ "$translated" -ne 1 ]; then
    echo "qemu adapter: expected one -device loader,file=<path>,addr=0x80200000 argument" >&2
    exit 2
fi

exec "$real" "${args[@]}"
